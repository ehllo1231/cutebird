# Unity-generated caches and local settings.
# Keep Assets/ (including .meta files), Packages/, and ProjectSettings/ tracked.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Keep the Windows apps used for map editing and playtesting.
# Ignore other build targets and generated debug data.
/[Bb]uild/
/[Bb]uilds/*
!/[Bb]uilds/Windows/
!/[Bb]uilds/Windows-Developer/
/[Bb]uilds/**/*_BurstDebugInformation_DoNotShip/
/[Bb]uilds/**/*_BackUpThisFolder_ButDontShipItWithYourGame/

# Test results and captures.
/[Tt]est[Rr]esults/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ee]xported[Oo]bj/

# IDE settings and Unity-generated solution/project files.
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.unityproj
*.booproj
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Unity diagnostics.
*.log
sysinfo.txt
crash.dmp

# Python verification tools: caches and local virtual environments.
__pycache__/
*.py[cod]
.venv/
venv/

# OS-generated files.
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local environment variables; keep example files shareable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
